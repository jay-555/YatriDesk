#!/bin/sh
set -e
systemctl daemon-reload >/dev/null 2>&1 || true
if [ "$1" = purge ]; then
  echo "yatrideesk: your data stays in Docker volumes (yatrideesk_pg_data, yatrideesk_uploads_data, yatrideesk_state) and your settings and generated passwords in /etc/yatrideesk/yatrideesk.env, so a later reinstall picks up where you left off. To delete everything for good: sudo docker compose --project-name yatrideesk down -v ; sudo rm -rf /etc/yatrideesk" >&2
fi
exit 0
